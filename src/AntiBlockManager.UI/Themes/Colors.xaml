<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Основные фоны -->
    <SolidColorBrush x:Key="BackgroundDark" Color="#0F0F13" />
    <SolidColorBrush x:Key="SurfaceDark" Color="#1A1A22" />
    <SolidColorBrush x:Key="SurfaceLight" Color="#252533" />
    
    <!-- Акценты (сине-фиолетовые) -->
    <SolidColorBrush x:Key="Accent" Color="#6C5CE7" />
    <SolidColorBrush x:Key="AccentHover" Color="#8172EB" />
    <SolidColorBrush x:Key="AccentGlow" Color="#806C5CE7" />
    
    <!-- Текст -->
    <SolidColorBrush x:Key="TextMain" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextMuted" Color="#A0A0B0" />
    
    <!-- Статусы -->
    <SolidColorBrush x:Key="StatusSuccess" Color="#00B894" />
    <SolidColorBrush x:Key="StatusError" Color="#FF7675" />
    <SolidColorBrush x:Key="StatusWarning" Color="#FDCB6E" />
    
</ResourceDictionary>