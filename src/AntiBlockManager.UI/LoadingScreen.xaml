<Window x:Class="AntiBlockManager.UI.LoadingScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка" Height="414" Width="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="White" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">

    <Border Background="#1A1A1A" CornerRadius="35">
        <Border.OpacityMask>
            <VisualBrush>
                <VisualBrush.Visual>
                    <Border Background="Black" CornerRadius="35" 
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}" 
                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                </VisualBrush.Visual>
            </VisualBrush>
        </Border.OpacityMask>

        <Grid>
            <!-- СКРЫТЫЙ ПЛЕЕР ДЛЯ ЗВУКА ЗАГРУЗКИ -->
            <MediaElement x:Name="SplashSoundPlayer" Volume="0.8" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Stop" />

            <!-- ВИДЕО НА ЗАДНЕМ ФОНЕ -->
            <MediaElement x:Name="BgVideo" 
                          Stretch="UniformToFill"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          IsMuted="True"
                          Volume="0"
                          MediaEnded="BgVideo_MediaEnded"/>

            <Border Background="Black" Opacity="0.7"/>

            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#80000000" Offset="0.7"/>
                        <GradientStop Color="#CC000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ПРОЦЕНТЫ И ПРОГРЕСС-БАР -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30">
                
                <!-- ТЕКСТ ПРОЦЕНТОВ -->
                <TextBlock x:Name="PercentageText" Text="0%" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                
                <Grid Width="350" Height="8">
                    <Border Background="#33FFFFFF" CornerRadius="4"/>
                    <Border x:Name="ProgressBarFill" Background="White" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>