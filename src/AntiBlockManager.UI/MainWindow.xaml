<Window x:Class="AntiBlockManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AntiBlockManager.UI"
        Title="AntiBlock Manager" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        Foreground="{DynamicResource TextMain}" MouseMove="Window_MouseMove" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- АНИМАЦИЯ ВРАЩЕНИЯ -->
        <Storyboard x:Key="VinylSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="AvatarRotation" 
                             Storyboard.TargetProperty="Angle" 
                             From="0" To="360" 
                             Duration="0:0:8" />
        </Storyboard>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="25" Opacity="0.3" ShadowDepth="5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernExpander" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource GlassBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextMain}" Padding="15,12" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Arrow" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="15,0,15,15"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ComboBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ComboBorder}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Width="30" HorizontalAlignment="Right">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource ComboBg}" CornerRadius="6" BorderBrush="{DynamicResource ComboBorder}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="200">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource SurfaceLight}" VerticalAlignment="Center">
                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource TextMain}" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Success}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="45" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="Transparent" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource SurfaceLight}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="110" />
            <Setter Property="Background" Value="{DynamicResource SurfaceLight}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="PulseGlow" Fill="{DynamicResource Success}" Opacity="0" Margin="-15">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="25"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" />
                            <Path x:Name="IconPlay" Data="M 0,0 L 0,32 L 28,16 Z" Fill="{DynamicResource TextMain}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Path x:Name="IconPause" Data="M 0,0 L 10,0 L 10,32 L 0,32 Z M 20,0 L 30,0 L 30,32 L 20,32 Z" Fill="{DynamicResource TextMain}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Ellipse x:Name="Spinner" Stroke="{DynamicResource Accent}" StrokeThickness="4" Width="50" Height="50" StrokeDashArray="10 6" Visibility="Collapsed">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" CenterX="25" CenterY="25" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="Tag" Value="Loading">
                                <Setter TargetName="IconPlay" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="IconPlay" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IconPause" Property="Visibility" Value="Visible"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
                                <Setter Property="Background" Value="{DynamicResource SurfaceLight}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="PulseGlow" Storyboard.TargetProperty="Opacity" From="0.1" To="0.4" Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceLight}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="20,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateButton" TargetType="Button" BasedOn="{StaticResource CheckButton}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="Checking">
                    <Setter Property="Background" Value="{DynamicResource Success}" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
                <Trigger Property="Tag" Value="Success">
                    <Setter Property="Background" Value="#2E7D32" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="Tag" Value="Error">
                    <Setter Property="Background" Value="#D32F2F" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlayerSlider" TargetType="Slider">
            <Setter Property="Height" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Background="{DynamicResource SurfaceLight}" Height="4" CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{DynamicResource Accent}" Height="4" CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource TextMain}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="40" Background="{DynamicResource BgMain}">
        <Border.OpacityMask>
            <VisualBrush>
                <VisualBrush.Visual>
                    <Border Background="Black" CornerRadius="40" 
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}" 
                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                </VisualBrush.Visual>
            </VisualBrush>
        </Border.OpacityMask>

        <Grid>
            <!-- ФОН -->
            <Grid>
                <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0.3"/>
                <MediaElement x:Name="BgVideo" Stretch="UniformToFill" Opacity="0.6" MediaEnded="BgVideo_MediaEnded" MediaFailed="BgVideo_MediaFailed" MediaOpened="BgVideo_MediaOpened"/>
            </Grid>
            
            <!-- ЗАТЕМНЕНИЕ -->
            <Border Background="{DynamicResource OverlayBg}"/>
            <local:ParticleBackground x:Name="Particles" />

            <!-- ПАНЕЛЬ УПРАВЛЕНИЯ ОКНОМ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,20,0">
                <Button x:Name="LangBtn" Background="{DynamicResource SurfaceLight}" Padding="10,5" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand" Click="LangBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RuText" Text="RU" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock x:Name="EnText" Text=" / EN" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </Button>
                <Button Content="&#xE921;" Style="{StaticResource IconButton}" FontSize="14" Padding="10,8" Click="MinimizeBtn_Click"/>
                <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" FontSize="14" Padding="10,8" Foreground="#FF7675" Click="CloseBtn_Click"/>
            </StackPanel>

            <!-- ВЕРХНЯЯ ПАНЕЛЬ НАВИГАЦИИ -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" 
                    Background="{DynamicResource GlassBg}" CornerRadius="30" Padding="10,5" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Grid x:Name="LogoContainer" VerticalAlignment="Center" Margin="15,0,20,0">
                        <Image x:Name="LogoImage" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="LogoFallback" Text="AB" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Rectangle Width="1" Fill="{DynamicResource GlassBorder}" Margin="0,5,10,5"/>

                    <Button x:Name="BtnNavHome" ToolTip="Главная" Content="&#xE80F;" Style="{StaticResource TopNavButton}" Click="Nav_Home"/>
                    <Button x:Name="BtnNavTelegram" ToolTip="Telegram" Content="&#xE724;" Style="{StaticResource TopNavButton}" Click="Nav_Telegram"/>
                    <Button x:Name="BtnNavZapret" ToolTip="Zapret" Content="&#xEA18;" Style="{StaticResource TopNavButton}" Click="Nav_Zapret"/>
                    <Button x:Name="BtnNavLogs" ToolTip="Логи" Content="&#xE8A5;" Style="{StaticResource TopNavButton}" Click="Nav_Logs"/>
                    <Button x:Name="BtnNavAssistant" ToolTip="Помощь / FAQ" Content="&#xE897;" Style="{StaticResource TopNavButton}" Click="Nav_Assistant"/>
                    <Button x:Name="BtnNavSettings" ToolTip="Настройки" Content="&#xE713;" Style="{StaticResource TopNavButton}" Click="Nav_Settings"/>
                    <Button x:Name="BtnNavUpdate" ToolTip="Обновление" Content="&#xE895;" Style="{StaticResource TopNavButton}" Click="Nav_Update"/>
                    <Button x:Name="BtnNavInfo" ToolTip="Информация" Content="&#xE946;" Style="{StaticResource TopNavButton}" Click="Nav_Info"/>
                </StackPanel>
            </Border>

            <!-- ОСНОВНОЙ КОНТЕНТ -->
            <Grid Margin="0,100,0,0">
                <!-- ГЛАВНАЯ -->
                <Grid x:Name="PageHome" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- КАРТОЧКИ -->
                    <Grid Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Width="180" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="YouTubeTitle" Text="YOUTUBE" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextMain}"/>
                                <TextBlock x:Name="YouTubeStatus" Text="НЕ АКТИВНО" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                                <Button x:Name="YouTubeBtn" Style="{StaticResource CircleButton}" Width="90" Height="90" Click="YouTubeBtn_Click"/>
                                <TextBlock x:Name="YouTubeTimer" Text="00:00:00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,15" Foreground="{DynamicResource TextMain}"/>
                                <Button x:Name="CheckYouTubeBtn" Content="Проверить" Style="{StaticResource CheckButton}" Click="CheckYouTubeBtn_Click"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Width="200" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DiscordTitle" Text="DISCORD" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextMain}"/>
                                <TextBlock x:Name="DiscordStatus" Text="НЕ АКТИВНО" FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                                <Button x:Name="DiscordBtn" Style="{StaticResource CircleButton}" Width="110" Height="110" Click="DiscordBtn_Click"/>
                                <TextBlock x:Name="DiscordTimer" Text="00:00:00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,15" Foreground="{DynamicResource TextMain}"/>
                                <Button x:Name="CheckDiscordBtn" Content="Проверить" Style="{StaticResource CheckButton}" Click="CheckDiscordBtn_Click"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Width="180" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TelegramTitle" Text="TELEGRAM" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextMain}"/>
                                <TextBlock x:Name="TelegramStatus" Text="НЕ АКТИВНО" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                                <Button x:Name="TelegramBtn" Style="{StaticResource CircleButton}" Width="90" Height="90" Click="TelegramBtn_Click"/>
                                <TextBlock x:Name="TelegramTimer" Text="00:00:00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,15" Foreground="{DynamicResource TextMain}"/>
                                <Button x:Name="CheckTelegramBtn" Content="Проверить" Style="{StaticResource CheckButton}" Click="CheckTelegramBtn_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ПЛЕЕР -->
                    <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Width="700" Height="120" HorizontalAlignment="Center" Margin="0,0,0,30" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- АВАТАРКА (КЛИКАБЕЛЬНАЯ) -->
                            <Border Grid.Column="0" Width="90" Height="90" Background="#1E1E1E" CornerRadius="45" Margin="0,0,15,0" MouseLeftButtonDown="ChangeAvatar_Click" Cursor="Hand" ToolTip="Нажмите, чтобы сменить аватарку">
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.Clip>
                                        <EllipseGeometry Center="45,45" RadiusX="45" RadiusY="45" />
                                    </Grid.Clip>
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="AvatarRotation" Angle="0" />
                                    </Grid.RenderTransform>
                                    <Image x:Name="UserAvatarImage" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" Margin="0,5,15,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- НАЗВАНИЕ ТРЕКА -->
                                <TextBlock x:Name="TrackNameText" Text="Rckes - Starter" Foreground="{DynamicResource TextMain}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                                
                                <Slider Grid.Row="2" x:Name="TrackSlider" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="100" 
                                        ValueChanged="TrackSlider_ValueChanged"
                                        PreviewMouseLeftButtonDown="TrackSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="TrackSlider_PreviewMouseLeftButtonUp"/>
                                
                                <Grid Grid.Row="3">
                                    <TextBlock x:Name="CurrentTimeText" Text="00:00" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TotalTimeText" Text="00:00" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE710;" Style="{StaticResource IconButton}" Click="AddTrack_Click" FontSize="18" Margin="0,0,10,0"/>
                                <Button Content="&#xE892;" Style="{StaticResource IconButton}" Click="PrevTrack_Click" FontSize="16" Margin="0,0,5,0"/>
                                <Button x:Name="PlayPauseBtn" Content="&#xE768;" Style="{StaticResource IconButton}" Click="PlayPause_Click" FontSize="20" Margin="0,0,5,0"/>
                                <Button Content="&#xE893;" Style="{StaticResource IconButton}" Click="NextTrack_Click" FontSize="16" Margin="0,0,15,0"/>
                                
                                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" FontSize="16" Margin="0,0,5,0"/>
                                <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="100" Value="50" ValueChanged="VolumeSlider_ValueChanged" Width="80" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ОСТАЛЬНЫЕ СТРАНИЦЫ -->
                <Grid x:Name="PageTelegram" Visibility="Collapsed" Margin="50">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TgPageTitle" Text="Telegram" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource TextMain}"/>
                            <Border Style="{StaticResource GlassPanel}" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="TgConnectHeader" Text="Подключение" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextMain}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Margin="0,0,10,0">
                                            <TextBox x:Name="TgLinkBox" Style="{StaticResource ModernTextBox}" Text="tg://socks?server=127.0.0.1&amp;port=1080" IsReadOnly="True"/>
                                            <Button Content="&#xE890;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,5,0" Click="ToggleLinkVisibility_Click"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="&#xE8C8;" Style="{StaticResource IconButton}" ToolTip="Копировать" Click="CopyLink_Click"/>
                                            <Button Content="&#xE8A7;" Style="{StaticResource IconButton}" ToolTip="Открыть в Telegram" Click="OpenLink_Click"/>
                                            <Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="Обновить" Click="RefreshLink_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TgConnectHint" Text="Данные скрыты." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassPanel}" Padding="20">
                                <StackPanel>
                                    <TextBlock x:Name="TgParamsHeader" Text="Параметры" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextMain}"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock x:Name="TgHostLabel" Text="Хост" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                            <Grid>
                                                <TextBox x:Name="TgHostBox" Style="{StaticResource ModernTextBox}" Text="127.0.0.1" IsReadOnly="True"/>
                                                <Button Content="&#xE890;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,5,0" Click="ToggleHostVisibility_Click"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock x:Name="TgPortLabel" Text="Порт" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                            <Grid>
                                                <TextBox x:Name="TgPortBox" Style="{StaticResource ModernTextBox}" Text="1080" IsReadOnly="True"/>
                                                <Button Content="&#xE890;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,5,0" Click="TogglePortVisibility_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="TgSecretLabel" Text="Секретный ключ" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                        <Grid>
                                            <TextBox x:Name="TgSecretBox" Style="{StaticResource ModernTextBox}" Text="ddbdb24ffb8c48e9d0ccd7784c3aebcef" IsReadOnly="True"/>
                                            <Button Content="&#xE890;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,5,0" Click="ToggleSecretVisibility_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PageZapret" Visibility="Collapsed" Margin="50">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="ZapretPageTitle" Text="Zapret Settings" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource TextMain}"/>
                            <Border Style="{StaticResource GlassPanel}" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="DiscordStrategyTitle" Text="Discord" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextMain}"/>
                                    <ComboBox x:Name="DiscordStrategyCombo" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="Fake"/><ComboBoxItem Content="Disorder"/><ComboBoxItem Content="Split"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassPanel}" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="YouTubeStrategyTitle" Text="YouTube" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextMain}"/>
                                    <ComboBox x:Name="YouTubeStrategyCombo" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="Fake"/><ComboBoxItem Content="Disorder"/><ComboBoxItem Content="Split"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassPanel}" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="TelegramStrategyTitle" Text="Telegram" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextMain}"/>
                                    <ComboBox x:Name="TelegramStrategyCombo" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="MTProto (SOCKS5)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Button x:Name="SaveStrategyBtn" Content="Сохранить" Width="150" Padding="15,10" Background="{DynamicResource Accent}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Click="SaveStrategyBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PageLogs" Visibility="Collapsed" Margin="50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LogsTitle" Text="Журнал логов" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource TextMain}"/>
                    <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Background="{DynamicResource LogBg}">
                        <ListBox x:Name="LogsList" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="12" Margin="10,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Grid x:Name="PageAssistant" Visibility="Collapsed" Margin="50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock x:Name="AiTitle" Text="Помощь и Частые Вопросы" FontSize="28" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock x:Name="AiSubtitle" Text="Ответы на самые популярные вопросы." FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Expander x:Name="FaqExpander1" Header="Начало работы" Style="{StaticResource ModernExpander}">
                                <StackPanel>
                                    <TextBlock x:Name="FaqText1_1" Text="Как включить защиту?" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,10,0,5"/>
                                    <TextBlock x:Name="FaqText1_2" Text="Нажмите на круглую кнопку с треугольником под нужным сервисом." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PageSettings" Visibility="Collapsed" Margin="50">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="SettingsTitle" Text="Настройки" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource TextMain}"/>
                            <Border Style="{StaticResource GlassPanel}" Padding="20">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAutoStart" Content="Запускать при входе в Windows" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="ChkMinimized" Content="Старт свернутым в трей" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="ChkLightTheme" Content="Светлая тема" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,15" Checked="ChkLightTheme_Checked" Unchecked="ChkLightTheme_Unchecked"/>
                                    <CheckBox x:Name="ChkAutoTg" Content="Автозапуск Telegram" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="ChkAutoDiscord" Content="Автозапуск Discord / YouTube" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,15"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PageInfo" Visibility="Collapsed" Margin="50">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="InfoTitle" Text="Информация" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource TextMain}"/>
                            <Border Style="{StaticResource GlassPanel}" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="InfoHeader" Text="Что это за приложение?" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{DynamicResource TextMuted}" Text="AntiBlock Manager — удобная программа для обхода блокировок."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassPanel}" Padding="20">
                                <StackPanel>
                                    <TextBlock x:Name="InfoCreatorsHeader" Text="Создатели" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextMain}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="InfoDevLabel" Grid.Column="0" Text="Разработчик:" Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="Kasic" Foreground="{DynamicResource TextMain}" FontSize="14" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="InfoTestLabel" Grid.Column="0" Text="Тестировщики:" Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="Kuts, Enot" Foreground="{DynamicResource TextMain}" FontSize="14" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PageUpdate" Visibility="Collapsed" Margin="50">
                    <StackPanel>
                        <TextBlock x:Name="UpdateTitle" Text="Обновление" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource TextMain}"/>
                        <Border Style="{StaticResource GlassPanel}" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="UpdateVersionText" Text="Текущая версия: v2.7.3" FontSize="16" Margin="0,0,0,15" Foreground="{DynamicResource TextMuted}"/>
                                <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" Content="Проверить обновления" Style="{StaticResource UpdateButton}" Padding="15,10" HorizontalAlignment="Left" FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>