<Window x:Class="AntiBlockManager.UI.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Уведомление" Height="75" Width="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False">

    <Border Background="#222222" CornerRadius="12" BorderBrush="#66BB6A" BorderThickness="4,0,0,0" Padding="15">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.6" ShadowDepth="3"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="🔔" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" x:Name="MessageText" Text="Сообщение" Foreground="White" 
                       VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" FontWeight="Medium"/>
        </Grid>
    </Border>
</Window>